# ---------------------------------------------------------------------------
# Discord bot configuration
# Copy this file to `.env` and fill in the values.
# ---------------------------------------------------------------------------

# Required: bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your-token-here

# Optional: your server ID. When set, slash commands sync instantly to this
# guild instead of waiting for global command propagation (up to 1 hour).
GUILD_ID=

# Optional overrides (defaults shown)
DB_PATH=data/bot.sqlite3
BLACKLIST_PATH=blacklisted_words.txt
AUTO_REPLIES_PATH=auto_replies.json
LOG_FILE=discord.log
LOG_LEVEL=INFO
